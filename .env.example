# API_KEY y CAPTURE_TOKEN_SECRET: los mismos valores que en api-fin/.env.
# CAPTURE_TOKEN_SECRET solo firma tokens de captura: 32+ caracteres, distinto de API_KEY y de JWT_ACCESS_SECRET.
API_KEY=
CAPTURE_TOKEN_SECRET=
# En producción, con el usuario ACL de Redis propio del servicio (ver README)
REDIS_URL=redis://:password@localhost:6389

# Proxies delante del servicio: 0 en local, 1 detrás de Traefik, 2 si además pasa por el proxy de Cloudflare
TRUST_PROXY_HOPS=0

PORT=8080
CAPTURE_STREAM_KEY=capture:notifications
CAPTURE_STREAM_MAXLEN=50000
MAX_TEXT_LENGTH=2000
RATE_PER_MINUTE=120
# Por dirección IP, antes de autenticar: freno a la fuerza bruta contra la API key
IP_RATE_PER_MINUTE=600
